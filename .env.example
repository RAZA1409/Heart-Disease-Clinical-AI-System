# Flask Application Configuration
SECRET_KEY=your_secure_random_flask_secret_key_here
ADMIN_RECOVERY_CODE=your_admin_password_recovery_code_here
ADMIN_DEFAULT_PASSWORD=admin123

# Database Configuration (Optional: defaults to local database.db)
# For Render Persistent Disk mount: /var/data/database.db
DATABASE_PATH=database.db

# External AI Services
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

