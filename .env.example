# ============================================================
# Multi-Disease Clinical AI Platform - Environment Variables
# ============================================================

# Flask Application Security
# In production on Render: MUST be set to a cryptographically secure random string (e.g. `openssl rand -hex 32`)
SECRET_KEY=your_secure_random_flask_secret_key_here

# Admin Authentication & Password Recovery
ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here
ADMIN_RECOVERY_CODE=your_admin_password_recovery_code_here

# Database Configuration
# Local Development: defaults to local database.db
# Render Persistent Disk: mount disk at /var/data and set DATABASE_PATH=/var/data/database.db
DATABASE_PATH=database.db

# Cookie & HTTPS Security Settings
# In production on Render: set to "true" (defaults to true automatically if RENDER is detected)
# In local HTTP development: set to "false"
SESSION_COOKIE_SECURE=false

# External AI Clinical Assistant
GEMINI_API_KEY=your_google_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration (Render automatically sets PORT)
PORT=5000
FLASK_DEBUG=false
